# Planetary Computer API Key (Optional; public access is available without key, but key raises rate limits)
PC_SDK_SUBSCRIPTION_KEY=

# Google Earth Engine / Google Cloud credentials (for optional 'gee' adapter)
# Option A: Service Account
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_FILE=
# Option B: GCP Project ID for user / Application Default Credentials
GEE_PROJECT_ID=

# Sentinel Hub credentials (for optional 'sentinel_hub' adapter)
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Cloud Storage (for optional 'gcs' storage adapter)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Basemap API Key (for CARTO Dark Matter or Voyager; default OSM and Esri are keyless)
CARTO_API_KEY=
VITE_CARTO_API_KEY=
